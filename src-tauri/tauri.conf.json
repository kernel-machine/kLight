{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kLight",
  "version": "0.1.0",
  "identifier": "app.klight.desktop",
  "build": {
    "frontendDist": "loader",
    "beforeBuildCommand": "sh ../scripts/update-qlcplus-fixtures.sh --if-missing && npm --prefix ../ui run build && cargo build --release -p klight-engine -p klight-supervisor --manifest-path ../Cargo.toml && node ../scripts/prepare-sidecars.mjs"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "kLight", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "externalBin": ["binaries/klight-supervisor", "binaries/klight-engine"],
    "resources": {
      "../ui/dist/": "ui/",
      "../fixtures/": "fixtures/",
      "../profiles/controllers/": "profiles/"
    }
  }
}
